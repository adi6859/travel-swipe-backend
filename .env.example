# Copy to .env for local development. Never commit real secrets.

APP_NAME=travel-swipe-api
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=debug

HTTP_ADDR=:8080
HTTP_TRUSTED_PROXIES=         # comma-separated CIDRs of your load balancer; empty = trust none
HTTP_MAX_BODY_BYTES=1048576
HTTP_ADMIN_MAX_BODY_BYTES=10485760   # admin imports carry up to 200 listings

# SHA-256 (hex) of the admin bearer token. Empty disables /admin/v1 entirely.
# Generate a token, keep it in your password manager, and store only its hash:
#   $t = openssl rand -hex 32; $t
#   [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($t))).Replace('-','').ToLower()
ADMIN_API_TOKEN_SHA256=

DATABASE_URL=postgres://travel:travel@localhost:5433/travel_swipe?sslmode=disable
# Integration tests RESET this database. Use a dedicated one.
TEST_DATABASE_URL=postgres://travel:travel@localhost:5433/travel_swipe_test?sslmode=disable

# Generate each with: openssl rand -hex 32   (must be >= 32 chars and differ)
AUTH_JWT_SECRET=
AUTH_OTP_SECRET=
AUTH_JWT_ISSUER=travel-swipe-api
AUTH_JWT_AUDIENCE=travel-swipe-app
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

AUTH_OTP_LENGTH=6
AUTH_OTP_TTL=5m
AUTH_OTP_RESEND_COOLDOWN=30s
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_PER_PHONE_PER_DAY=10
# Fixed test numbers, non-production only: +919999999999:123456,+919888888888:654321
AUTH_TEST_PHONE_OTPS=

SMS_PROVIDER=console          # console (non-production only) | msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
